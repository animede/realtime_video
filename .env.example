# Web server. Keep HOST on loopback when using a reverse proxy.
HOST=127.0.0.1
PORT=8781

# Internal diffusers-movie-server gateway. Do not expose it publicly.
GATEWAY_URL=http://127.0.0.1:8630
GATEWAY_PRESET=nvfp4-fast
JOB_POLL_INTERVAL=0.35

# OpenAI-compatible Vision LLM endpoint.
VISION_LLM_URL=https://llm.example.internal/v1/chat/completions
VISION_LLM_MODEL=
VISION_LLM_API_KEY=

# Persistent uploads, generated clips, and scenario JSON files.
REALTIME_VIDEO_DATA=./data

# Optional vocal-separation integration.
LIPSYNC_APP_DIR=/opt/Minimax-H3-lipsync-mv
VOCAL_ANALYSIS_PYTHON=/opt/Minimax-H3-lipsync-mv/.venv/bin/python
STEM_API_URL=http://127.0.0.1:8889
DEMUCS_PYTHON=/opt/easy_music_v2/.venv/bin/python
